{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gklabs Device Manager",
  "version": "1.2.0",
  "identifier": "com.gkcc.app",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Real-time system monitor",
    "publisher": "gklabs",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gklabs Device Manager",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3MkEyM0MwREQzRkY5QjkKUldTNStUL2R3Q01xZDI5QkhwUGppR3I0NkRybW5iRkRiM2p3YkM3a2N0MThHVDVQbWFMa3pzeTIK",
      "endpoints": [
        "https://github.com/gkson-lab/gk-control-center/releases/latest/download/latest.json"
      ]
    }
  }
}